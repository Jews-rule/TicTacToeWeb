@page
<!DOCTYPE html>
<html>
<head>
    <title>Крестики-нолики</title>
    <style>
            body { text-align: center; font-family: Arial; }
            .grid {
                display: grid;
                grid-template-columns: repeat(3, 100px);
                gap: 5px;
                justify-content: center;
                margin-top: 50px;
            }
            button {
                width: 100px;
                height: 100px;
                font-size: 40px;
            }
    </style>
</head>
<body>

    <h1>Крестики-нолики</h1>

    <div class="grid" id="grid"></div>

    <script>
            let board = Array(9).fill(null);
            let isXTurn = true;

            const grid = document.getElementById("grid");

            for (let i = 0; i < 9; i++) {
                let btn = document.createElement("button");

                btn.onclick = () => {
                    if (board[i]) return;

                    let symbol = isXTurn ? "X" : "O";
                    board[i] = symbol;
                    btn.innerText = symbol;

                    if (checkWin(symbol)) {
                        alert("Победил " + symbol);
                        location.reload();
                        return;
                    }

                    if (!board.includes(null)) {
                        alert("Ничья!");
                        location.reload();
                        return;
                    }

                    isXTurn = !isXTurn;
                };

                grid.appendChild(btn);
            }

            function checkWin(s) {
                const wins = [
                    [0,1,2],[3,4,5],[6,7,8],
                    [0,3,6],[1,4,7],[2,5,8],
                    [0,4,8],[2,4,6]
                ];

                return wins.some(w =>
                    board[w[0]] === s &&
                    board[w[1]] === s &&
                    board[w[2]] === s
                );
            }
    </script>

</body>
</html>